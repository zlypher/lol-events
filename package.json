{
    "name": "lol-events",
    "version": "1.0.0",
    "description": "League of Legends calendar in iCal for all major leagues",
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "main": "index.js",
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "scripts:leagues": "tsx _scripts/get-leagues.ts",
        "scripts:ical": "tsx _scripts/create-ical.ts",
        "scripts:manifest": "tsx _scripts/create-manifest.ts",
        "scripts:readme": "tsx _scripts/create-readme.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zlypher/lol-events.git"
    },
    "author": "Thomas Prochazka <thomas.prochazka@gmail.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/zlypher/lol-events/issues"
    },
    "homepage": "https://github.com/zlypher/lol-events#readme",
    "dependencies": {
        "ical-generator": "11.1.3",
        "p-limit": "7.3.3",
        "qs": "6.17.1"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.6.6",
        "@types/qs": "6.15.1",
        "dotenv": "18.0.9",
        "eslint": "10.14.0",
        "prettier": "3.9.10",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1",
        "vitest": "5.0.5"
    }
}
