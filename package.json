{
    "name": "lol-events",
    "version": "1.0.0",
    "description": "League of Legends calendar in iCal for all major leagues",
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "main": "index.js",
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "scripts:leagues": "node _scripts/get-leagues.js",
        "scripts:ical": "node _scripts/create-ical.js",
        "scripts:readme": "node _scripts/create-readme.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zlypher/lol-events.git"
    },
    "author": "Thomas Prochazka <thomas.prochazka@gmail.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/zlypher/lol-events/issues"
    },
    "homepage": "https://github.com/zlypher/lol-events#readme",
    "dependencies": {
        "ical-generator": "11.1.2",
        "qs": "6.16.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "dotenv": "18.0.4",
        "eslint": "10.11.0",
        "prettier": "3.9.9",
        "vitest": "5.0.2"
    }
}
